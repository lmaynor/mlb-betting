# .env.example — copy to .env for local development
# Never commit .env to git

# ── Local mode (no GCS, no Cloud SQL) ──────────────────────────────────────
# MLB_GCS_BUCKET=                      # leave empty for local file mode
# MLB_DB_URL=                          # leave empty for SQLite

# ── GCP mode ───────────────────────────────────────────────────────────────
# MLB_GCS_BUCKET=my-gcp-project-mlb-data
# MLB_DB_URL=postgresql+pg8000://mlb:password@/mlb_betting?unix_sock=/cloudsql/my-project:us-central1:mlb-betting-db/.s.PGSQL.5432
# GCP_PROJECT=my-gcp-project
# GCP_REGION=us-central1

# ── Data paths (local dev) ──────────────────────────────────────────────────
# MLB_BASE_DATA=C:\Users\lmayn\Downloads\Baseball_Data   # Windows
# MLB_BASE_DATA=/home/user/Baseball_Data                  # Linux/Mac
# MLB_BASE_DIR=C:\Users\lmayn\Downloads\mlb-betting       # Windows

# ── Discord ─────────────────────────────────────────────────────────────────
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Per-system overrides (optional):
# DISCORD_WEBHOOK_NRFI=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_HR=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_F5=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_K=https://discord.com/api/webhooks/...
