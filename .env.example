# Betting backend (GCP Cloud Run -- read-only via public API)
BETTING_API_URL=https://api.beezy.fyi
BETTING_API_KEY=your-site-api-key-here   # matches site-api-key in Secret Manager

# Vercel Postgres (for learn_articles -- provision in Vercel dashboard)
LEARN_DATABASE_URL=postgres://...        # injected automatically if using Vercel Postgres

# Anthropic (article generation)
ANTHROPIC_API_KEY=sk-ant-...

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe (disabled pre-launch, populate when ready)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SEASON=price_...

# Admin
ADMIN_SECRET_KEY=your-secret-key-here

# Cron (Vercel generates this automatically)
CRON_SECRET=your-cron-secret-here

# GCS (for NRFI conditions + pitcher matchup tool data)
GCS_BUCKET_NAME=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Discord (for reconcile cron alerts)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Geo-blocking (comma-separated 2-letter US state codes, e.g. NY,WA -- empty = block nothing)
BLOCKED_STATES=

# App
NEXT_PUBLIC_BASE_URL=https://beezy.fyi

# REMOVED: DATABASE_URL -- the bets table is accessed via BETTING_API_URL,
# not via direct Postgres. If you need local dev DB access for learn_articles,
# set LEARN_DATABASE_URL to a local postgres DSN.
