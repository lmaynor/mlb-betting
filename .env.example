# mlb-betting local development environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
#
# On Cloud Run, all of these are injected via Secret Manager or the
# service's environment variable configuration. This file is for local
# dev only.

# ── Required for GCS mode (Cloud Run) ────────────────────────────────────
# GCS bucket name (matches Secret Manager: mlb-gcs-bucket)
MLB_GCS_BUCKET=concrete-crow-445205-m4-mlb-data

# Cloud SQL connection string (matches Secret Manager: mlb-db-url)
# Format: postgresql+pg8000://{user}:{password}@/{db}?unix_sock=/cloudsql/{INSTANCE}/...
MLB_DB_URL=

# SportsGameOdds API key (matches Secret Manager: sgo-api-key)
SGO_API_KEY=

# Discord webhook URL (matches Secret Manager: discord-webhook-url)
DISCORD_WEBHOOK_URL=

# ── Optional per-system Discord webhooks ─────────────────────────────────
# If set, each system posts to its own channel instead of DISCORD_WEBHOOK_URL
# DISCORD_WEBHOOK_HR=
# DISCORD_WEBHOOK_NRFI=
# DISCORD_WEBHOOK_F5=
# DISCORD_WEBHOOK_K=
# DISCORD_WEBHOOK_SUMMARY=   # cross-system daily P&L summary (settle_bets.py)

# ── Required for Cloud Run ────────────────────────────────────────────────
GCP_PROJECT=concrete-crow-445205-m4

# ── Local dev only ────────────────────────────────────────────────────────
# Base path for local data files (Windows path from notebook era)
# MLB_BASE_DATA=C:\Users\lmayn\Downloads\Baseball_Data

# ── Optional feature flags ────────────────────────────────────────────────
# Set to 1 to skip the leakage guard during K retrain (faster dev reruns)
# K_SKIP_LEAKAGE_CHECK=0

# ── Cloud Run sets this automatically ────────────────────────────────────
PORT=8080
