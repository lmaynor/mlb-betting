{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/tools/layout,_N_T_/tools/pitcher-matchups/layout,_N_T_/tools/pitcher-matchups/page,_N_T_/tools/pitcher-matchups"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/tools/pitcher-matchups/__PAGE__",
    "/tools/pitcher-matchups",
    "/tools",
    "/_index",
    "/_head"
  ]
}