# Files sent to Cloud Build as build context.
# beezy-vip deploys to Vercel separately -- exclude entirely to avoid
# uploading 2500+ headshot images on every Cloud Run deploy.
.gcloudignore
.git
.gitignore

# Vercel frontend -- not part of the Cloud Run image. The one exception is the engine-accuracy table the Dockerfile COPYs
# (tweet_drafter reads it); a gitignore-style file cannot re-include a file under an excluded directory, so exclude the
# directory CONTENTS level by level.
beezy-vip/*
!beezy-vip/lib/
beezy-vip/lib/*
!beezy-vip/lib/engine-accuracy.json

# Notebooks and local dev artifacts
*.ipynb
ipynb_CONTEXT/
handoffs/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Local virtual environments
.venv/
.venv_audit/

# Local Windows data paths (never used in Cloud Run)
*.db
*.sqlite

# Never part of the Cloud Run image (the Dockerfile COPYs mlb_core/ nba/ nfl/ nhl/ mlb/ ev/ + a few named scripts, main.py,
# tweet_drafter.py, setup.py and beezy-vip/lib/engine-accuracy.json -- nothing under data/ or .claude/):
# agent worktrees (each is a full repo copy), local data dumps, env files (may hold keys), node_modules.
.claude/
data/
.env
.env.*
**/.env
**/.env.*
node_modules/
**/node_modules/
