# Copy to .env for local runs. Never commit a real .env.
# On Cloud Run, supply these as env vars / Secret Manager secrets instead.

# Discord application
DISCORD_TOKEN=
CLIENT_ID=
# Optional: register slash commands to one guild (instant). Unset = global (up to ~1h).
GUILD_ID=
# Your Discord user id. Only this user may run /setup-server.
OWNER_ID=

# Beezy API (Cloud Run service). The key is sent as the X-API-Key header.
BETTING_API_URL=
BETTING_API_KEY=

# Google Gemini via its OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shared secret that authenticates POST /internal/sync-role (header X-Beezy-Secret).
# Leave unset and the endpoint answers 503; an empty secret is never accepted.
BEEZY_BOT_SECRET=

SITE_URL=https://beezy.fyi
PORT=8080
# Optional SQLite path (default ./beezy-bot.db). Use a persistent volume in production.
DB_PATH=
